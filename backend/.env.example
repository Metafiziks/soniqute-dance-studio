# ── Server ────────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/pams-dance-studio
# or MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET_NAME=your_gcs_bucket_name
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/YOUR_BUCKET_NAME
# Set GOOGLE_APPLICATION_CREDENTIALS env var pointing to your service account JSON

# ── AI Video Generation ───────────────────────────────────────────────────────
WAVESPEED_API_KEY=your_wavespeed_api_key
SHOTSTACK_API_KEY=your_shotstack_api_key

# ── NFT / Blockchain ──────────────────────────────────────────────────────────
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
QUTIE_CONTRACT_ADDRESS=0xYOUR_QUTIE_CONTRACT_ADDRESS
CHUMS_CONTRACT_ADDRESS=0xYOUR_CHUMS_CONTRACT_ADDRESS
PACK_CONTRACT_ADDRESS=0xYOUR_PACK_CONTRACT_ADDRESS
CHAIN_ID=1

# ── hCaptcha ──────────────────────────────────────────────────────────────────
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key
