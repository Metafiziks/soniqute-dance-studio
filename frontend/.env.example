# ── API ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:10000

# ── NFT / Blockchain ──────────────────────────────────────────────────────────
NEXT_PUBLIC_PAMS_CONTRACT_ADDRESS=0xYOUR_PAMS_NFT_CONTRACT_ADDRESS
NEXT_PUBLIC_CHUMS_CONTRACT_ADDRESS=0xYOUR_CHUMS_NFT_CONTRACT_ADDRESS
NEXT_PUBLIC_PACK_CONTRACT_ADDRESS=0xYOUR_PACK_CONTRACT_ADDRESS
NEXT_PUBLIC_CHAIN_ID=1

# ── Storage ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GCS_BASE_URL=https://storage.googleapis.com/YOUR_BUCKET_NAME

# ── Auth (NextAuth) ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_here
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# ── External Services ─────────────────────────────────────────────────────────
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
NEXT_PUBLIC_OPENSEA_API_KEY=your_opensea_api_key
